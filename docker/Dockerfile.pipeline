FROM python:3.11-slim
WORKDIR /app
COPY requirements-final.txt .
RUN pip install --no-cache-dir -r requirements-final.txt
COPY src ./src
COPY run_model_pipeline.py .
COPY run_pre_presentation_validations.py .
COPY data ./data
COPY models ./models
COPY reports ./reports
CMD ["python", "run_model_pipeline.py"]
